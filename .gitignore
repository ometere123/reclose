# dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# env / secrets
.env
.env.local
.env.*.local
*.keystore.json
*.pem
*.key
# gltest.config.yaml holds raw deployer private keys when generating a fee profile
# (gltest_cli's PRECONFIGURED_NETWORKS accounts field expects hex private keys, not a keystore
# reference) - never commit a real one. .env.example/this comment document the shape instead.
gltest.config.yaml

# generated artifacts directory (contract addresses/schemas gltest writes on deploy)
artifacts/

# build artifacts
dist/
frontend/vendor/
build/
*.tsbuildinfo

# logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# local scratch (never commit ad-hoc local test scaffolding)
/scratch/
/tmp/

# Ephemeral live-write fee/arg scratch files produced by scripts/*-retest*.mjs helpers - real
# transaction evidence belongs in deployment/*/r*-manifest.json, not these transient dumps.
.a2-c01-retest-*.json
.r1r-*.json

# Credential-bearing explorer/simulation dumps are generated-only. Keep redacted
# copies in release evidence; never add a raw dump containing private_key values.
**/e1a-explorer-search-raw.json
**/explorer-deployer-search.json
**/simulation-failure.json
**/simulation-results.json

