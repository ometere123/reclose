# Reclose R1 - environment template. Copy to .env and fill in locally.
# NEVER commit a real .env file. NEVER put a private key, seed phrase, or
# keystore password directly in this file or in .env.

# --- Network (see toolchain/network.lock.json for the accepted values) ---
GENLAYER_NETWORK=studio-dev
GENLAYER_CHAIN_ID=61997
GENLAYER_RPC_URL=https://studio-next.genlayer.com/api

# --- Deployer / signer (reference only - use the GenLayer CLI keystore, never a raw key here) ---
# GENLAYER_ACCOUNT_NAME=reclose-deployer

# --- Sentinel (least-privilege reporting wallet only; never owner/treasury authority) ---
# SENTINEL_ACCOUNT_NAME=

# --- Hosted API / indexer (convenience only; never a correctness dependency, see Section 32 of CLAUDE.md) ---
# RECLOSE_API_URL=

# --- LLM/evidence-source configuration placeholders (fill per Judge/Sentinel requirements at C2) ---
# EVIDENCE_SOURCE_ALLOWLIST=
