{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reclose.internal/schemas/evidence/SourceAuthorityRegistry.schema.json",
  "title": "Source Authority Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sources"],
  "properties": {
    "schema": { "const": "reclose-source-registry-v1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "canonicalOrigin", "sourceClass", "ruleIds", "enabled"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$" },
          "canonicalOrigin": { "type": "string", "pattern": "^https://[^/@]+(?::443)?$", "maxLength": 256 },
          "sourceClass": {
            "enum": [
              "AUTHORITATIVE_SIGNED",
              "AUTHORITATIVE_PUBLIC",
              "ONCHAIN",
              "INDEPENDENT_PUBLIC",
              "CONTENT_ADDRESSED_SNAPSHOT",
              "DERIVED_DETERMINISTIC"
            ]
          },
          "ruleIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "PROVIDER_COMPROMISE_V1",
                "SERVICE_FAILURE_V1",
                "REMEDIATION_CONFIRMED_V1",
                "RECOVERY_VALIDATED_V1"
              ]
            }
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
